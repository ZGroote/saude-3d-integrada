NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-publishable
# Segredo do servidor para assinar o cookie de inatividade; defina com pelo menos 32 bytes aleatórios.
# Gere localmente com: openssl rand -base64 32
SESSAO_SEGREDO=
# onde estão as pastas <atlas>/<versao>; padrão /atlas (npm run atlas)
NEXT_PUBLIC_ATLAS_URL=/atlas
